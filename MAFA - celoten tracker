/************************************************************
 * SHRANI NASTAVITVE
 ************************************************************/

function saveSettings_(registrationForm, followupForms) {

  const sheet = getSpreadsheet_()
    .getSheetByName(CONFIG.SHEETS.SETTINGS);

  const rows = [

    [
      'REGISTRATION_FORM_ID',
      registrationForm.getId()
    ],

    [
      'REGISTRATION_FORM_URL',
      registrationForm.getPublishedUrl()
    ],

    [
      'REGISTRATION_FORM_EDIT_URL',
      registrationForm.getEditUrl()
    ]
  ];


  CONFIG.FOLLOW_UP_DAYS.forEach(day => {

    rows.push([
      'FORM_' + day + '_ID',
      followupForms[day].getId()
    ]);

    rows.push([
      'FORM_' + day + '_URL',
      followupForms[day].getPublishedUrl()
    ]);

    rows.push([
      'FORM_' + day + '_EDIT_URL',
      followupForms[day].getEditUrl()
    ]);
  });


  sheet
    .getRange(
      2,
      1,
      rows.length,
      2
    )
    .setValues(rows);
}


/************************************************************
 * TRIGGERJI
 ************************************************************/

function installTriggers_(registrationForm, followupForms) {

  const oldTriggers = ScriptApp.getProjectTriggers();


  oldTriggers.forEach(trigger => {

    const handler = trigger.getHandlerFunction();

    if (
      handler === 'onRegistrationSubmit' ||
      handler === 'onFollowupSubmit' ||
      handler === 'sendDailyReminders'
    ) {

      ScriptApp.deleteTrigger(trigger);
    }
  });


  /***********************
   * REGISTRACIJA
   ***********************/

  ScriptApp
    .newTrigger('onRegistrationSubmit')
    .forForm(registrationForm)
    .onFormSubmit()
    .create();


  /***********************
   * DNEVNE FORME
   ***********************/

  CONFIG.FOLLOW_UP_DAYS.forEach(day => {

    ScriptApp
      .newTrigger('onFollowupSubmit')
      .forForm(followupForms[day])
      .onFormSubmit()
      .create();
  });


  /***********************
   * DNEVNI MAILI
   ***********************/

  ScriptApp
    .newTrigger('sendDailyReminders')
    .timeBased()
    .everyDays(1)
    .atHour(CONFIG.SEND_HOUR)
    .create();
}


/************************************************************
 * OB REGISTRACIJI PACIENTA
 ************************************************************/

function onRegistrationSubmit(e) {

  try {

    const data = formResponseToObject_(e.response);

    const patientId = createPatientId_();

    const name =
      data['Ime in priimek'];

    const email =
      data['Elektronska pošta'];

    const phone =
      data['Telefon'];

    const surgeryDate =
      new Date(data['Datum operacije']);

    const antibiotics =
      data['Ali trenutno jemljete antibiotično terapijo?'];

    const antibioticName =
      data['Če jemljete antibiotik, katerega?'] || '';


    const therapy =
      antibiotics === 'Da'
        ? antibioticName || 'Da'
        : 'Ne';


    const ss = getSpreadsheet_();


    /***********************
     * PACIENT
     ***********************/

    ss
      .getSheetByName(CONFIG.SHEETS.PATIENTS)
      .appendRow([
        patientId,
        name,
        email,
        phone,
        surgeryDate,
        therapy,
        new Date(),
        'Aktiven'
      ]);


    /***********************
     * OPOMNIKI
     ***********************/

    const reminderSheet =
      ss.getSheetByName(CONFIG.SHEETS.REMINDERS);


    CONFIG.FOLLOW_UP_DAYS.forEach(day => {

      const reminderDate =
        addDays_(surgeryDate, day);

      const form =
        getFollowupForm_(day);

      const url =
        createPrefilledUrl_(
          form,
          patientId
        );


      reminderSheet.appendRow([
        patientId,
        name,
        email,
        day,
        reminderDate,
        false,
        '',
        false,
        '',
        url
      ]);

    });


    /***********************
     * POTRDITVENI MAIL
     ***********************/

    sendRegistrationConfirmation_(
      name,
      email
    );


    log_(
      'REGISTRACIJA',
      patientId,
      'Pacient uspešno registriran.'
    );


  } catch (error) {

    log_(
      'NAPAKA REGISTRACIJE',
      '',
      error.stack || error.toString()
    );

    throw error;
  }
}


/************************************************************
 * ODGOVORE IZ FORME PRETVORI V OBJEKT
 ************************************************************/

function formResponseToObject_(response) {

  const data = {};

  response.getItemResponses().forEach(itemResponse => {

    const title =
      itemResponse.getItem().getTitle();

    data[title] =
      itemResponse.getResponse();
  });

  return data;
}


/************************************************************
 * PERSONALIZIRANA POVEZAVA
 ************************************************************/

function createPrefilledUrl_(form, patientId) {

  const patientItem =
    form
      .getItems(FormApp.ItemType.TEXT)
      .map(item => item.asTextItem())
      .find(item =>
        item.getTitle() === 'PatientID'
      );


  if (!patientItem) {

    throw new Error(
      'V formi ni vprašanja PatientID.'
    );
  }


  const response =
    form.createResponse();


  response.withItemResponse(
    patientItem.createResponse(patientId)
  );


  return response.toPrefilledUrl();
}


/************************************************************
 * DNEVNO POŠILJANJE MAILOV
 ************************************************************/

function sendDailyReminders() {

  const ss = getSpreadsheet_();

  const sheet =
    ss.getSheetByName(CONFIG.SHEETS.REMINDERS);

  const lastRow =
    sheet.getLastRow();


  if (lastRow < 2) {
    return;
  }


  const values =
    sheet
      .getRange(
        2,
        1,
        lastRow - 1,
        10
      )
      .getValues();


  const today =
    stripTime_(new Date());


  values.forEach((row, index) => {

    const patientId = row[0];

    const name = row[1];

    const email = row[2];

    const day = Number(row[3]);

    const reminderDate =
      stripTime_(new Date(row[4]));

    const sent =
      row[5] === true;

    const answered =
      row[7] === true;

    const formUrl =
      row[9];


    if (
      reminderDate.getTime() <= today.getTime() &&
      !sent &&
      !answered
    ) {

      try {

        sendFollowupEmail_(
          name,
          email,
          day,
          formUrl
        );


        const rowNumber =
          index + 2;


        sheet
          .getRange(rowNumber, 6)
          .setValue(true);


        sheet
          .getRange(rowNumber, 7)
          .setValue(new Date());


        log_(
          'OPOMNIK POSLAN',
          patientId,
          'Dan ' + day
        );


      } catch (error) {

        log_(
          'NAPAKA PRI POŠILJANJU',
          patientId,
          'Dan ' +
          day +
          ': ' +
          error.toString()
        );
      }
    }
  });
}


