/************************************************************
 * SETTINGS
 ************************************************************/

function getSettings_() {

  const sheet =
    getSpreadsheet_()
      .getSheetByName(
        CONFIG.SHEETS.SETTINGS
      );


  const result = {};


  if (!sheet) {
    return result;
  }


  const lastRow =
    sheet.getLastRow();


  if (lastRow < 2) {
    return result;
  }


  sheet
    .getRange(
      2,
      1,
      lastRow - 1,
      2
    )
    .getValues()
    .forEach(row => {

      if (row[0]) {
        result[row[0]] = row[1];
      }
    });


  return result;
}


/************************************************************
 * PATIENT ID
 ************************************************************/

function createPatientId_() {

  return (
    'P-' +
    Utilities
      .getUuid()
      .replace(/-/g, '')
      .substring(0, 10)
      .toUpperCase()
  );
}


/************************************************************
 * DATUMI
 ************************************************************/

function addDays_(date, days) {

  const result =
    new Date(date);

  result.setDate(
    result.getDate() + days
  );

  return result;
}


function stripTime_(date) {

  return new Date(
    date.getFullYear(),
    date.getMonth(),
    date.getDate()
  );
}


/************************************************************
 * PREPOZNA DAN IZ NASLOVA FORME
 ************************************************************/

function getDayFromForm_(form) {

  const formId = form.getId();
  const settings = getSettings_();

  for (const day of CONFIG.FOLLOW_UP_DAYS) {

    if (settings['FORM_' + day + '_ID'] === formId) {
      return day;
    }

  }

  throw new Error(
    'Iz ID-ja forme ni mogoče ugotoviti dneva. Form ID: ' + formId
  );
}


/*
 * Stara funkcija ostane samo zaradi kompatibilnosti,
 * vendar je pri novih odgovorih ne uporabljamo več.
 */
function extractDayFromFormTitle_(title) {

  const match = String(title).match(/(\d+)\.\s*dan/i);

  if (!match) {
    throw new Error(
      'Iz naslova forme ni mogoče ugotoviti dneva: ' + title
    );
  }

  return Number(match[1]);
}


/************************************************************
 * LOG
 ************************************************************/

function log_(event, patientId, details) {

  try {

    const sheet =
      getSpreadsheet_()
        .getSheetByName(
          CONFIG.SHEETS.LOG
        );


    sheet.appendRow([
      new Date(),
      event,
      patientId,
      details
    ]);


  } catch (error) {

    console.error(
      event,
      patientId,
      details,
      error
    );
  }
}


/************************************************************
 * HTML ESCAPE
 ************************************************************/

function escapeHtml_(text) {

  if (
    text === null ||
    text === undefined
  ) {
    return '';
  }


  return String(text)

    .replace(/&/g, '&amp;')

    .replace(/</g, '&lt;')

    .replace(/>/g, '&gt;')

    .replace(/"/g, '&quot;')

    .replace(/'/g, '&#039;');
}


