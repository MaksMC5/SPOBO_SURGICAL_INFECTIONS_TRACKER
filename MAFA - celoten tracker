/************************************************************
 * GLAVNA NAMESTITEV
 ************************************************************/

function setupSystem() {

  const ss = SpreadsheetApp.getActiveSpreadsheet();

  PropertiesService
    .getScriptProperties()
    .setProperty('SPREADSHEET_ID', ss.getId());

  setupSheets_(ss);

  const registrationForm = createRegistrationForm_();

  const followupForms = {};

  CONFIG.FOLLOW_UP_DAYS.forEach(day => {
    followupForms[day] = createFollowupForm_(day);
  });

  saveSettings_(registrationForm, followupForms);

  installTriggers_(registrationForm, followupForms);

  SpreadsheetApp.getUi().alert(
    'Sistem je uspešno ustvarjen.\n\n' +
    'Ustvarjene so forme za dan 1, 7, 14, 30 in 90.\n\n' +
    'V vsako dnevno formo moraš zdaj samo še ročno dodati vprašanje "File upload" za fotografijo kirurške rane.'
  );
}


/************************************************************
 * PRIDOBI GLAVNI SPREADSHEET
 ************************************************************/

function getSpreadsheet_() {

  const id = PropertiesService
    .getScriptProperties()
    .getProperty('SPREADSHEET_ID');

  if (!id) {
    return SpreadsheetApp.getActiveSpreadsheet();
  }

  return SpreadsheetApp.openById(id);
}


/************************************************************
 * USTVARI TABELE
 ************************************************************/

function setupSheets_(ss) {

  const definitions = {

    PACIENTI: [
      'PatientID',
      'Ime in priimek',
      'Elektronska pošta',
      'Telefon',
      'Datum operacije',
      'Terapija / antibiotik ob registraciji',
      'Datum registracije',
      'Status'
    ],

    OPOMNIKI: [
      'PatientID',
      'Ime in priimek',
      'Elektronska pošta',
      'Dan po operaciji',
      'Datum opomnika',
      'Poslano',
      'Datum pošiljanja',
      'Odgovorjeno',
      'Datum odgovora',
      'Povezava na formo'
    ],

    ODGOVORI: [
      'Timestamp',
      'PatientID',
      'Dan po operaciji',

      'Bolečina 0–10',
      'Senzibiliteta 0–10',

      'Oteklina',
      'Rdečina',
      'Vročina',
      'Izcedek',
      'Dehiscenca',

      'Brez težav',

      'Antibiotična terapija',
      'Kateri antibiotik',

      'Komentar',

      'Fotografija'
    ],

    NASTAVITVE: [
      'Nastavitev',
      'Vrednost'
    ],

    LOG: [
      'Timestamp',
      'Dogodek',
      'PatientID',
      'Podrobnosti'
    ]
  };


  Object.keys(definitions).forEach(name => {

    let sheet = ss.getSheetByName(name);

    if (!sheet) {
      sheet = ss.insertSheet(name);
    }

    sheet.clear();

    const headers = definitions[name];

    sheet
      .getRange(1, 1, 1, headers.length)
      .setValues([headers])
      .setFontWeight('bold')
      .setBackground('#d9ead3')
      .setHorizontalAlignment('center');

    sheet.setFrozenRows(1);

    sheet.autoResizeColumns(1, headers.length);

    if (sheet.getFilter()) {
      sheet.getFilter().remove();
    }

    sheet
      .getRange(
        1,
        1,
        Math.max(sheet.getMaxRows(), 2),
        headers.length
      )
      .createFilter();
  });


  const patients = ss.getSheetByName('PACIENTI');
  patients.setColumnWidth(1, 150);
  patients.setColumnWidth(2, 200);
  patients.setColumnWidth(3, 230);
  patients.setColumnWidth(5, 130);

  const reminders = ss.getSheetByName('OPOMNIKI');
  reminders.setColumnWidth(1, 150);
  reminders.setColumnWidth(2, 200);
  reminders.setColumnWidth(3, 230);
  reminders.setColumnWidth(5, 140);
  reminders.setColumnWidth(10, 300);

  const responses = ss.getSheetByName('ODGOVORI');
  responses.setColumnWidth(1, 160);
  responses.setColumnWidth(2, 150);
  responses.setColumnWidth(14, 350);
  responses.setColumnWidth(15, 300);
}


