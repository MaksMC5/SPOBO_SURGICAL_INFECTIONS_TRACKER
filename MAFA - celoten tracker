        'Če jemljete antibiotik, katerega?'
      ] || '',

      data[
        'Želite o stanju rane še kaj dodati? Imate kakšno vprašanje?'
      ] || '',

      photo

    ]);


    markReminderAnswered_(
      patientId,
      day
    );


    log_(
      'ODGOVOR PREJET',
      patientId,
      'Dan ' + day
    );


  } catch (error) {

    log_(
      'NAPAKA ODGOVORA',
      '',
      error.stack || error.toString()
    );

    throw error;
  }
}


/************************************************************
 * POSKUS PRIDOBITVE FOTOGRAFIJE
 ************************************************************/

function getPhotoResponse_(response) {

  const responses =
    response.getItemResponses();


  for (let i = 0; i < responses.length; i++) {

    const itemResponse =
      responses[i];

    const item =
      itemResponse.getItem();


    if (
      item.getTitle() === 'Fotografija kirurške rane'
    ) {

      const value =
        itemResponse.getResponse();


      if (Array.isArray(value)) {

        return value
          .map(fileId => {
            return 'https://drive.google.com/open?id=' + fileId;
          })
          .join(', ');
      }


      return String(value || '');
    }
  }


  return '';
}


/************************************************************
 * OZNAČI, DA JE ODGOVOR PREJET
 ************************************************************/

function markReminderAnswered_(patientId, day) {

  const sheet =
    getSpreadsheet_()
      .getSheetByName(
        CONFIG.SHEETS.REMINDERS
      );


  const lastRow =
    sheet.getLastRow();


  if (lastRow < 2) {
    return;
  }


  const rows =
    sheet
      .getRange(
        2,
        1,
        lastRow - 1,
        10
      )
      .getValues();


  for (let i = 0; i < rows.length; i++) {

    const id =
      rows[i][0];

    const reminderDay =
      Number(rows[i][3]);


    if (
      id === patientId &&
      reminderDay === Number(day)
    ) {

      sheet
        .getRange(i + 2, 8)
        .setValue(true);


      sheet
        .getRange(i + 2, 9)
        .setValue(new Date());


      return;
    }
  }
}


